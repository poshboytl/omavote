{
  "name": "omavote-web",
  "version": "0.1.0",
  "private": true,
  "description": "Omavote web frontend: readable ballots signed in the wallet, relayed on CKB, verifiable by anyone",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/omavote-wasm --target web --out-dir ../../web/src/wasm/pkg --release",
    "dev": "node scripts/check-wasm.mjs && vite",
    "build": "node scripts/check-wasm.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/check-wasm.mjs && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
