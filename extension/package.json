{
  "name": "omavote-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Omavote signer: a browser extension that holds one dedicated voting key and signs only Omavote delegate ballots",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/omavote-wasm --target web --out-dir ../../extension/src/wasm/pkg --release",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --devnet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
